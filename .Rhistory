mc_price <- function(S, K, r, sigma, Tt,
q = 0,
type = c("call", "put"),
nsim = 200000,
seed = 20260924) {
type <- match.arg(type)
set.seed(seed)
Z <- rnorm(nsim)
ST <- S * exp(
(r - q - 0.5 * sigma^2) * Tt +
sigma * sqrt(Tt) * Z
)
payoff <- if (type == "call") {
pmax(ST - K, 0)
} else {
pmax(K - ST, 0)
}
payoff_desc <- exp(-r * Tt) * payoff
precio <- mean(payoff_desc)
se <- sd(payoff_desc) / sqrt(nsim)
ic95 <- precio + c(-1, 1) * 1.96 * se
list(
precio = precio,
se = se,
ic95 = ic95
)
}
resultado_mc_bjork <- mc_price(
S = S0,
K = opcion$strike,
r = r,
sigma = sigma,
Tt = plazo_anios,
q = 0,
type = "call",
nsim = 200000,
